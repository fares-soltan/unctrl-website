{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unctrl-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unctrl-db",
      "database_id": "9ca3dbd2-e56a-4378-96ac-9fa5ee4047a9"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MEDIA",
      "id": "3672fbecceb8415a846367711e4e64b5"
    }
  ],
  "observability": { "enabled": true }
}
